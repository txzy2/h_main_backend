generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Activity {
  Active
  Inactive
  Pending
  Closed
}

enum BookingStatus {
  Pending
  Confirmed
  Cancelled
  Completed
}

enum BookingActionType {
  Created
  Started
  Extended
  Closed
  Cancelled
}

enum RequestStatus {
  Pending
  InProgress
  Approved
  Rejected
}

model User {
  id Int @id @default(autoincrement())

  login String @unique
  name  String

  phoneNumber String  @map("phone") @db.VarChar(11)
  position    String? @db.VarChar(100)

  extId String       @unique @map("ext_id") @db.VarChar(64)
  org   Organization @relation(fields: [orgId], references: [id])
  orgId Int          @map("org_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  tickets   Tickets[]
  shifts    Shift[]

  @@index([orgId])
  @@map("users")
}

model Organization {
  id   Int    @id @default(autoincrement())
  name String @unique

  inn String @unique @db.VarChar(12)
  kpp String @db.VarChar(9)

  director String @db.VarChar(255)

  status Activity
  //TODO: Добавить хранение иконок организации

  uniqueHash String  @unique @map("unique_hash") @db.VarChar(64)
  updatedBy  String? @map("updated_by") @db.VarChar(64)

  licenses  License[]
  locations Location[]
  users     User[]
  tickets   Tickets[]
  shifts    Shift[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("orgs")
}

model Location {
  id Int @id @default(autoincrement())

  uniqueHash String @unique @map("unique_hash") @db.VarChar(64)

  org   Organization @relation(fields: [orgId], references: [id])
  orgId Int          @map("org_id")

  name    String  @db.VarChar(255)
  address String  @db.VarChar(255)
  phone   String? @db.VarChar(11)

  activePlaces Int @map("active_places") @db.Integer
  //TODO: Сделать карту заведения

  status Activity

  bookings       Booking[]
  locationTables LocationTables[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orgId, status])
  @@map("locations")
}

model Booking {
  id Int @id @default(autoincrement())

  location   Location @relation(fields: [locationId], references: [id])
  locationId Int      @map("location_id")

  table   LocationTables? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableId Int?            @map("table_id")

  userExtId       String        @map("user_ext_id") @db.VarChar(64)
  guestName       String?       @map("guest_name") @db.VarChar(255)
  guestPhone      String?       @map("guest_phone") @db.VarChar(20)
  guestsCount     Int           @map("guests_count")
  status          BookingStatus
  scheduledAt     DateTime      @map("scheduled_at")
  // Плановая длительность брони в минутах (можно продлевать)
  durationMinutes Int           @default(120) @map("duration_minutes")
  seatedAt        DateTime?     @map("seated_at")
  completedAt     DateTime?     @map("completed_at")

  // Сумма чека и оценка гостя — для аналитики дашборда
  amount Int  @default(0)
  rating Int?

  comment String? @db.VarChar(255)

  actions BookingAction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // locationId + scheduledAt — расписание броней по точке за период
  @@index([locationId, scheduledAt])
  // userExtId — все брони конкретного пользователя
  @@index([userExtId])
  // status + scheduledAt — выборка pending/confirmed броней на сегодня/завтра
  @@index([status, scheduledAt])
  @@index([tableId])
  @@index([guestPhone])
  @@index([scheduledAt])
  @@map("bookings")
}

model LocationTables {
  id Int @id @default(autoincrement())

  location   Location @relation(fields: [locationId], references: [id])
  locationId Int      @map("location_id")

  name String? @default("") @db.VarChar(255)

  bookings Booking[]

  //TODO: Если понадобится сделать тип (VIP или нет -> надо будет скороее всего добавить таблицу, чтобы держать типы)
  // Через enum не подойдет, чтобы клиент мог кастомить типы и названия

  @@map("location_tables")
}

/// История действий по брони: создание, продление, закрытие, отмена.
model BookingAction {
  id Int @id @default(autoincrement())

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId Int     @map("booking_id")

  type BookingActionType

  userExtId String @map("user_ext_id") @db.VarChar(64)

  minutes Int?
  amount  Int?
  comment String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([bookingId, createdAt])
  @@map("booking_actions")
}

model Shift {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @map("user_id")

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId Int          @map("org_id")

  startsAt     DateTime  @map("starts_at")
  endsAt       DateTime? @map("ends_at")
  bookingsGoal Int       @default(0) @map("bookings_goal")

  // Фактическая явка менеджера: когда нажал «Выйти на смену» / «Закончить смену»
  actualStartedAt DateTime? @map("actual_started_at")
  actualEndedAt   DateTime? @map("actual_ended_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, actualStartedAt])
  @@index([orgId, startsAt])
  @@index([userId, startsAt])
  @@map("shifts")
}

model License {
  id Int @id @default(autoincrement())

  org   Organization @relation(fields: [orgId], references: [id])
  orgId Int          @map("org_id")

  plan   Plans @relation(fields: [planId], references: [id])
  planId Int   @map("plan_id")

  active Activity

  createdAt DateTime @default(now()) @map("created_at")
  expiredAt DateTime @map("expired_at")

  // orgId + active — получить активную лицензию организации
  @@index([orgId, active])
  // expiredAt — джоб который ищет истекающие лицензии
  @@index([expiredAt])
  @@map("licenses")
}

model Plans {
  id Int @id @default(autoincrement())

  name         String @unique @db.VarChar(255)
  maxLocations Int    @map("max_locations")
  price        Int
  description  String @db.VarChar(255)

  licenses License[]

  @@map("plans")
}

model TicketType {
  id       Int     @id @default(autoincrement())
  alias    String  @unique @db.VarChar(64)
  name     String  @db.VarChar(255)
  isActive Boolean @default(true) @map("is_active")

  tickets Tickets[]

  @@map("ticket_types")
}

model Tickets {
  id       Int    @id @default(autoincrement())
  ticketId String @unique @map("ticket_id") @db.VarChar(64)

  orgId        Int          @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id])

  typeId Int        @map("type_id")
  type   TicketType @relation(fields: [typeId], references: [id])

  requestedData Json?         @map("requested_data")
  status        RequestStatus @default(Pending)
  reason        String?       @db.Text
  email         String        @db.VarChar(255)

  userByExtId     String  @map("user_by_ext_id") @db.VarChar(64)
  user            User    @relation(fields: [userByExtId], references: [extId])
  reviewedByExtId String? @map("reviewed_by_ext_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orgId, status])
  @@index([typeId, status])
  @@map("tickets")
}
